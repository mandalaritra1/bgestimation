{
    "NAME": "ttbar",
    "GLOBAL": {
        "FILE": "TTbarAllHad$process.root",
        "FILE_UP": "TTbarAllHad$process_$syst_up.root",
        "FILE_DOWN": "TTbarAllHad$process_$syst_down.root",
        "HIST": "MttvsMt$region",
        "HIST_UP": "MttvsMt$region$systup",
        "HIST_DOWN": "MttvsMt$region$systdown",
        "path": "test_inputs/ttbar_clamp_to_data_cen24",
        "SIGNAME": [
            "signalZPrime4000"
        ]
    },
    "REGIONS": {
        "Cen24Pass": {
            "PROCESSES": [
                "24_SIGNAME",
                "24_TTbar"
            ],
            "BINNING": "default"
        },
        "Cen24Fail": {
            "PROCESSES": [
                "24_SIGNAME",
                "24_TTbar"
            ],
            "BINNING": "default"
        }
    },
    "PROCESSES": {
        "data_obs": {
            "SYSTEMATICS": [],
            "SCALE": 1.0,
            "COLOR": "black",
            "TYPE": "DATA",
            "TITLE": "Data",
            "ALIAS": "24_Data",
            "LOC": "path/FILE:HIST"
        },
        "24_SIGNAME": {
            "SYSTEMATICS": [
                "lumi24",
                "pileup24",
                "pdf24",
                "jes24",
                "jer24",
                "q2_24",
                "ttag_pt1_24"
            ],
            "SCALE": 0.000276,
            "COLOR": "black",
            "TYPE": "SIGNAL",
            "TITLE": "Z^{#prime}, 1#% #mathrm{width}",
            "LOC": "path/FILE:HIST"
        },
        "24_TTbar": {
            "SYSTEMATICS": [
                "lumi24",
                "ttbar_xsec",
                "pileup24",
                "pdf24",
                "jes24",
                "jer24",
                "q2_24",
                "ttag_pt1_24"
            ],
            "SCALE": 1.0,
            "COLOR": "red",
            "TYPE": "BKG",
            "TITLE": "t#bar{t}",
            "LOC": "path/FILE:HIST"
        }
    },
    "SYSTEMATICS": {
        "lumi24": {
            "CODE": 0,
            "VAL": 1.02
        },
        "ttbar_xsec": {
            "CODE": 0,
            "VAL": 1.2
        },
        "pileup24": {
            "ALIAS": "PILEUP",
            "CODE": 2,
            "UP": "path/FILE:HIST_UP",
            "DOWN": "path/FILE:HIST_DOWN",
            "SCALE": 1.0,
            "SIGMA": 1.0
        },
        "pdf24": {
            "ALIAS": "PDF",
            "CODE": 2,
            "UP": "path/FILE:HIST_UP",
            "DOWN": "path/FILE:HIST_DOWN",
            "SCALE": 1.0,
            "SIGMA": 1.0
        },
        "jes24": {
            "ALIAS": "JES",
            "CODE": 2,
            "UP": "path/FILE:HIST_UP",
            "DOWN": "path/FILE:HIST_DOWN",
            "SCALE": 1.0,
            "SIGMA": 1.0
        },
        "jer24": {
            "ALIAS": "JER",
            "CODE": 2,
            "UP": "path/FILE:HIST_UP",
            "DOWN": "path/FILE:HIST_DOWN",
            "SCALE": 1.0,
            "SIGMA": 1.0
        },
        "q2_24": {
            "ALIAS": "Q2",
            "CODE": 2,
            "UP": "path/FILE:HIST_UP",
            "DOWN": "path/FILE:HIST_DOWN",
            "SCALE": 1.0,
            "SIGMA": 1.0
        },
        "ttag_pt1_24": {
            "ALIAS": "TTAG_PT1",
            "CODE": 2,
            "UP": "path/FILE:HIST_UP",
            "DOWN": "path/FILE:HIST_DOWN",
            "SCALE": 1.0,
            "SIGMA": 5.0
        }
    },
    "BINNING": {
        "default": {
            "X": {
                "NAME": "jetmass",
                "TITLE": "m_{t} [GeV]",
                "BINS": [
                    25,
                    60,
                    105,
                    130,
                    150,
                    170,
                    180,
                    190,
                    200,
                    210,
                    475
                ],
                "SIGSTART": 105,
                "SIGEND": 210
            },
            "Y": {
                "NAME": "resmass",
                "TITLE": "m_{t#bar{t}} [GeV]",
                "BINS": [
                    800,
                    1100,
                    1300,
                    1500,
                    1700,
                    1900,
                    2100,
                    2300,
                    2500,
                    2900,
                    3500,
                    6500
                ]
            }
        }
    },
    "OPTIONS": {
        "blindedPlots": [
            "Cen24Pass"
        ],
        "blindedFit": [
            "Cen24Pass"
        ],
        "plotPrefitSigInFitB": true,
        "plotUncerts": false,
        "plotTitles": false,
        "plotTemplateComparisons": true,
        "plotEvtsPerUnit": false,
        "year": 24
    }
}